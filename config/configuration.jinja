      - name: "Tronity ID Buzz Plugged"
        unique_id: tronity_id_buzz_plugged
        state: {{ "'{{ states(''sensor.tronity_id_buzz_lwb_plugged'') | lower == ''true'' }}'"}}
        availability: {{ "'{{ states(''sensor.tronity_id_buzz_lwb_plugged'') not in [''unknown'', ''unavailable'', ''none''] }}'"}}
  - switch:
      - unique_id: cumulus_enfants_sauter_boost_switch
        turn_on:
