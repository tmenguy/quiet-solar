python_script:

logger:
  default: info


input_boolean:
  legrand_ticker:
    name: "Legrand Ticker"
  legrand_pumpkin:
    name: "Legrand Pumpkin"
  homekit_hub_alive:
    name: "HomeKit Hub Alive"
{%- for s in legrand_switches_to_map.switches %}
  {{ s.slug }}_state:
    name: "{{ s.name }} - HK Mirror (read)"
  {{ s.slug }}_command:
    name: "{{ s.name }} - HK Command (write)"
{%- endfor %}

template:
  - trigger:
      - platform: homeassistant
        event: start
    sensor:
      - name: "HA last start"
        unique_id: ha_last_start
        device_class: timestamp
        state: {{ "'{{ now().isoformat() }}'" }}
  - trigger:
      - platform: time_pattern
        seconds: "/15"
      - platform: state
        entity_id:
          - input_boolean.legrand_pumpkin
          - input_boolean.homekit_hub_alive
          - input_boolean.legrand_ticker
    binary_sensor:
      - name: "Legrand HomeKit link healthy"
        unique_id: legrand_homekit_link_healthy
        state: >
          {{ "{% set boot = states('sensor.ha_last_start') %}" }}
          {{ "{% set warming = boot not in ['unknown', 'unavailable', 'none'] and (now() - as_datetime(boot)).total_seconds() < 120 %}" }}
          {{ "{{ (not warming) and (now() - states.input_boolean.legrand_pumpkin.last_changed).total_seconds() < 90 }}" }}
        availability: {{ "'{{ states.input_boolean.legrand_pumpkin is not none }}'" }}
      - name: "HomeKit hub healthy"
        unique_id: homekit_hub_healthy
        state: >
          {{ "{% set boot = states('sensor.ha_last_start') %}" }}
          {{ "{% set warming = boot not in ['unknown', 'unavailable', 'none'] and (now() - as_datetime(boot)).total_seconds() < 120 %}" }}
          {{ "{{ (not warming) and (now() - states.input_boolean.homekit_hub_alive.last_changed).total_seconds() < 90 }}" }}
        availability: {{ "'{{ states.input_boolean.homekit_hub_alive is not none }}'" }}
      - name: "Tronity ID Buzz Plugged"
        unique_id: tronity_id_buzz_plugged
        state: {{ "'{{ states(''sensor.tronity_id_buzz_lwb_plugged'') | lower == ''true'' }}'"}}
        availability: {{ "'{{ states(''sensor.tronity_id_buzz_lwb_plugged'') not in [''unknown'', ''unavailable'', ''none''] }}'"}}
  - switch:
      - unique_id: cumulus_enfants_sauter_boost_switch
        turn_on:
        - action: number.set_value
          target:
            entity_id:
            - number.cumulus_enfants_boost_mode_duration
          data:
            value: '1'
        turn_off:
        - action: number.set_value
          target:
            entity_id:
            - number.cumulus_enfants_boost_mode_duration
          data:
            value: '0'
        default_entity_id: switch.cumulus_enfants_sauter_boost_switch
        name: Boost Cumulus Enfants
        state: {{ "'{{ not is_state(''number.cumulus_enfants_boost_mode_duration'', ''0'') }}'" }}
  - switch:
      - unique_id: radiateur_serviettes_parents_qs_switch
        turn_on:
        - action: climate.set_hvac_mode
          target:
            entity_id:
            - climate.salle_de_bains_des_parents
          data:
            hvac_mode: heat
        turn_off:
        - action: climate.set_hvac_mode
          target:
            entity_id:
            - climate.salle_de_bains_des_parents
          data:
            hvac_mode: auto
        default_entity_id: switch.radiateur_serviettes_parents_qs_switch
        name: QS Radiateur Serviette Parents
        state: {{ "'{{ is_state(''climate.salle_de_bains_des_parents'', ''heat'') }}'" }}
  - switch:
      - unique_id: radiateur_serviettes_enfants_qs_switch
        turn_on:
        - action: climate.set_hvac_mode
          target:
            entity_id:
            - climate.salle_de_bains_des_enfants
          data:
            hvac_mode: heat
        turn_off:
        - action: climate.set_hvac_mode
          target:
            entity_id:
            - climate.salle_de_bains_des_enfants
          data:
            hvac_mode: auto
        default_entity_id: switch.radiateur_serviettes_enfants_qs_switch
        name: QS Radiateur Serviette Enfants
        state: {{ "'{{ is_state(''climate.salle_de_bains_des_enfants'', ''heat'') }}'" }}
  - switch:
      - unique_id: radiateur_serviettes_arthur_qs_switch
        turn_on:
        - action: climate.set_hvac_mode
          target:
            entity_id:
            - climate.salle_de_bains_darthur
          data:
            hvac_mode: heat
        turn_off:
        - action: climate.set_hvac_mode
          target:
            entity_id:
            - climate.salle_de_bains_darthur
          data:
            hvac_mode: auto
        default_entity_id: switch.radiateur_serviettes_arthur_qs_switch
        name: QS Radiateur Serviette Arthur
        state: {{ "'{{ is_state(''climate.salle_de_bains_darthur'', ''heat'') }}'" }}
{##  --- BEGIN: generated Legrand façade switches --- ##}
{#- ================================================================================ -#}
{#- RULE: Never trust a value you just wrote. Never report a value you can't trust.   -#}
{#-                                                                                  -#}
{#- We write input_boolean.<slug>_command and we write the Netatmo cloud switch, so   -#}
{#- NEITHER can be evidence -- they only parrot back what we told them. The Netatmo   -#}
{#- switch writes its state optimistically, and it read 'off' all day on 2026-07-27   -#}
{#- while the boiler drew 2353 W. Reading it back after our own write is guaranteed   -#}
{#- to return the target, so a wait that consults it is VACUOUSLY TRUE and the        -#}
{#- notification branch unreachable.                                                  -#}
{#-                                                                                  -#}
{#- input_boolean.<slug>_state (the mirror) is written only by Apple Home from        -#}
{#- watching the real device, and follows a real change in 2-3 s. It is the only      -#}
{#- honest witness, so it is the only leg used for state and for both waits. Do NOT   -#}
{#- "restore symmetry" by re-adding the cloud term anywhere below: a backup that lies -#}
{#- is worse than no backup, because it sits at 'off' and reports it with full        -#}
{#- confidence. Going dark honestly is better.                                        -#}
{#-                                                                                  -#}
{#- Three things below look like they could be tidied. None of them can:              -#}
{#-  1. There is deliberately NO availability: key. A falsy availability makes HA     -#}
{#-     filter the entity out of entity-service calls with only a warning, so every   -#}
{#-     actuation would be SILENTLY SWALLOWED -- and both health sensors force        -#}
{#-     themselves off for 120 s after an HA restart. Untrusted must stay AVAILABLE.  -#}
{#-  2. The untrusted branch emits {{ none }}, not the string 'unknown'. cv.boolean   -#}
{#-     is applied without none_on_unknown_unavailable, so a string logs an ERROR on  -#}
{#-     every single evaluation.                                                       -#}
{#-  3. The cloud write sits alone in a parallel: branch because pyatmo raises plain  -#}
{#-     Exception subclasses, which continue_on_error does NOT swallow. Inline, a 429  -#}
{#-     would abort the script before the diagnostic could fire.                       -#}
{#-                                                                                  -#}
{#- Full derivation and source citations: docs/stories/QS-305.story.md and its two    -#}
{#- review fix plans. Do not re-derive from memory.                                    -#}
{#- ================================================================================ -#}
{%- for s in legrand_switches_to_map.switches %}
{##  --- Dual-channel actuation, mirror-only trust --- ##}
  - switch:
      - unique_id: {{ s.slug }}_facade
        default_entity_id: switch.{{ s.slug }}_facade
        name: {{ s.name | tojson }}
        state: >
          {{ "{% set hk_ok = is_state('binary_sensor.legrand_homekit_link_healthy', 'on') and is_state('binary_sensor.homekit_hub_healthy', 'on') %}" }}
          {{ "{% set mirror = states('input_boolean." ~ s.slug ~ "_state') %}" }}
          {{ "{% set mirror_valid = hk_ok and mirror in ['on','off'] %}" }}
          {{ "{% if mirror_valid %}" }}
            {{ "{{ mirror == 'on' }}" }}
          {{ "{% else %}" }}
            {{ "{{ none }}" }}
          {{ "{% endif %}" }}
        turn_on:
          - action: input_boolean.turn_on
            target:
              entity_id: input_boolean.{{ s.slug }}_command
            continue_on_error: true
          - parallel:
              - sequence:
                  - action: switch.turn_on
                    target:
                      entity_id: {{ s.cloud_entity }}
                    continue_on_error: true
              - sequence:
                  - wait_template: >-
                      {{ "{{ is_state('input_boolean." ~ s.slug ~ "_state', 'on') }}" }}
                    timeout: "00:00:10"
                    continue_on_timeout: true
                  - choose:
                      - conditions: >-
                          {{ "{{ not is_state('input_boolean." ~ s.slug ~ "_state', 'on') }}" }}
                        sequence:
                          - action: persistent_notification.create
                            data:
                              title: {{ (s.name ~ " - turn_on not confirmed") | tojson }}
                              message: >-
                                {{ "{{ 'Both channels were driven but the mirror did not confirm on within 10 s. mirror=' ~ states('input_boolean." ~ s.slug ~ "_state') ~ ' at ' ~ now().isoformat() }}" }}
                              notification_id: {{ s.slug }}_facade_on_unconfirmed
                    default:
                      - action: persistent_notification.dismiss
                        data:
                          notification_id: {{ s.slug }}_facade_on_unconfirmed
        turn_off:
          - action: input_boolean.turn_off
            target:
              entity_id: input_boolean.{{ s.slug }}_command
            continue_on_error: true
          - parallel:
              - sequence:
                  - action: switch.turn_off
                    target:
                      entity_id: {{ s.cloud_entity }}
                    continue_on_error: true
              - sequence:
                  - wait_template: >-
                      {{ "{{ is_state('input_boolean." ~ s.slug ~ "_state', 'off') }}" }}
                    timeout: "00:00:10"
                    continue_on_timeout: true
                  - choose:
                      - conditions: >-
                          {{ "{{ not is_state('input_boolean." ~ s.slug ~ "_state', 'off') }}" }}
                        sequence:
                          - action: persistent_notification.create
                            data:
                              title: {{ (s.name ~ " - turn_off not confirmed") | tojson }}
                              message: >-
                                {{ "{{ 'Both channels were driven but the mirror did not confirm off within 10 s. mirror=' ~ states('input_boolean." ~ s.slug ~ "_state') ~ ' at ' ~ now().isoformat() }}" }}
                              notification_id: {{ s.slug }}_facade_off_unconfirmed
                    default:
                      - action: persistent_notification.dismiss
                        data:
                          notification_id: {{ s.slug }}_facade_off_unconfirmed
{%- endfor %}
{## --- END: generated Legrand façade switches --- ##}
  - binary_sensor:
      - name: twingo_fixed_plug
        unique_id: twingo_fixed_plug
        state: >
            {{ "{% set is_plugged = 'off' %}"}}
            {{ "{% if is_state('sensor.gm367np_plug_state', ['plugged', 'plugged_waiting_for_charge']) %}"}}
            {{ "    {% set is_plugged = 'on' %}"}}
            {{ "{% elif is_state('binary_sensor.gm367np_plug', ['on']) %}"}}
            {{ "    {% set is_plugged = 'on' %}"}}
            {{ "{% elif is_state('sensor.gm367np_charge_state', ['waiting_for_current_charge','charge_in_progress','waiting_for_a_planned_charge','charge_ended']) %}"}}
            {{ "    {% set is_plugged = 'on' %}"}}
            {{ "{% endif %}"}}
            {{ "{{is_plugged}}"}}
        availability: >
            {{ "{{ (not is_state('sensor.gm367np_charge_state', 'unavailable')) or (is_state('sensor.gm367np_plug_state', ['plugged', 'plugged_waiting_for_charge'])) }}"}}
  - sensor:
      - name: twingo_fixed_perc_battery
        unique_id: twingo_fixed_perc_battery
        state_class: measurement
        device_class: battery
        unit_of_measurement: '%'
        state: >
          {{ "{{ states('sensor.gm367np_battery') }}"}}
        availability: >
          {{ "{% set is_available = false -%}"}}
          {{ "{% if states('sensor.gm367np_battery')|is_number -%}" }}
          {{ "    {% set is_available = true -%}" }}
          {{ "    {% if states('sensor.gm367np_battery')|float(0)  == 100 -%}" }}
          {{ "        {% set charging_status = states('sensor.gm367np_charge_state') -%}" }}
          {{ "        {% set plug_status = states('sensor.gm367np_plug_state') -%}" }}
          {{ "        {% set battery_autonomy = states('sensor.gm367np_battery_autonomy') -%}" }}
          {{ "        {% if  charging_status is none or is_state('sensor.gm367np_charge_state',['unavailable', 'unknown', 'none', 'waiting_for_current_charge']) -%}" }}
          {{ "            {% set is_available = false -%}" }}
          {{ "        {% elif plug_status is none or is_state('sensor.gm367np_plug_state',['unavailable', 'unknown', 'none', 'plug_unknown']) -%}" }}
          {{ "            {% set is_available = false -%}" }}
          {{ "        {% elif battery_autonomy is none or is_state('sensor.gm367np_battery_autonomy',['unavailable', 'unknown', 'none']) or (battery_autonomy|float(2) < 170) -%}" }}
          {{ "            {% set is_available = false -%}" }}
          {{ "        {% endif -%}" }}
          {{ "    {% endif -%}" }}
          {{ "{% endif -%}" }}
          {{ "{{is_available}}"}}
  - sensor:
      - name: house_consumption_power
        unique_id: house_consumption_power
        state_class: measurement
        device_class: power
        unit_of_measurement: W
        state: >
          {{ "{% set inv_active_power = states('sensor.inverter_active_power')|float(0) %}" }}
          {{ "{% set pm_active_power = states('sensor.emma_active_power')|float(0) %}" }}
          {{ "{{ (inv_active_power + pm_active_power)|float(0)|round(0) }}"}}
        availability: >
          {{ "{{ (states('sensor.inverter_active_power')|is_number) and (states('sensor.emma_active_power')|is_number) }}" }}
  - sensor:
      - name: power_meter_active_power_inverted
        unique_id: power_meter_active_power_inverted
        state_class: measurement
        device_class: power
        unit_of_measurement: W
        state: >
          {{ "{% set pm_active_power = states('sensor.emma_active_power')|float(0) %}" }}
          {{ "{{ (0 - pm_active_power)|float(0)|round(0) }}" }}
        availability: >
          {{ "{{ (states('sensor.emma_active_power')|is_number) }}" }}
  - sensor:
      - name: batteries_charge_discharge_power_inverted
        unique_id: batteries_charge_discharge_power_inverted
        state_class: measurement
        device_class: power
        unit_of_measurement: W
        state: >
          {{ "{% set pm_charge_power = states('sensor.batteries_charge_discharge_power')|float(0) %}" }}
          {{ "{{ (0 - pm_charge_power)|float(0)|round(0) }}" }}
        availability: >
          {{ "{{ (states('sensor.batteries_charge_discharge_power')|is_number) }}" }}
{%- for power in all_power_to_be_corrected.sensors %}
  - trigger:
      - platform: state
        entity_id: {{"sensor." + power }}
        not_to:
          - unknown
          - unavailable
    sensor:
     -  name: {{power}}{{postfix_power}}
        unique_id: {{power}}{{postfix_power}}
        state: >
          {{ "{{ trigger.to_state.state }}" }}
        state_class: measurement
        device_class: power
        unit_of_measurement: W
{%- endfor %}
{%- for group_name, group_list in power_groups %}
  - sensor:
     -  name: Total {{group_name}} power
        unique_id: total_{{group_name}}_power
        state_class: measurement
        device_class: power
        unit_of_measurement: W
        state: >
          {{'{{ ( 0.0 '}}
          {% for power in group_list.sensors -%}
          {{ '+ states("sensor.' + power + postfix_power + '") |float(default=0)'}}
          {% endfor -%}
          {{ ') | round(' + round_val | string + ') }}' }}
{%- endfor %}
  - sensor:
     -  name: Total rad and clim power
        unique_id: total_rad_and_clim_power
        state_class: measurement
        device_class: power
        unit_of_measurement: W
        state: >
          {{'{{ (states("sensor.total_radiateurs_power") |float(default=0)'}}
          {{ '+ states("sensor.total_clim_power") |float(default=0)'}}
          {{ ') | round(' + round_val | string + ') }}' }}
  - sensor:
     -  name: Total the rest measured power
        unique_id: total_the_rest_measured_power
        state_class: measurement
        device_class: power
        unit_of_measurement: W
        state: >
          {{'{{ (states("sensor.total_all_measured_power") |float(default=0)'}}
          {%- for group_name, group_list in power_groups %}
          {% if group_name != 'all_measured' -%}
          {{ '- states("sensor.total_' + group_name + '_power") |float(default=0)'}}
          {%- endif -%}
          {% endfor -%}
          {{ ') | round(' + round_val | string + ') }}' }}
  - sensor:
     -  name: Total left unmeasured power
        unique_id: total_left_unmeasured_power
        state_class: measurement
        device_class: power
        unit_of_measurement: W
        state: >
          {{'{{ (states("sensor.house_consumption_power' + postfix_power + '") |float(default=0)'}}
          {{ '- states("sensor.total_all_measured_power") |float(default=0)'}}
          {{ ') | round(' + round_val | string + ') }}' }}

homekit:
  - filter:
     include_entities:
        - sensor.porte_dentree_battery
        - cover.store
        - climate.salon
